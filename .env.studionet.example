# Never commit funded private keys. Copy this file to .env only on the test machine.
TEST_WALLET_A_PRIVATE_KEY=0x...
TEST_WALLET_B_PRIVATE_KEY=0x...

# GenLayer deployment made by the main wallet.
CONTRACT_ADDRESS=0x...

# Exact verified Ethereum mainnet deployment observed through eth.blockscout.com.
TARGET_CONTRACT_ADDRESS=0x...

# Immutable GitHub runbook identity and byte commitment.
RUNBOOK_OWNER=owner
RUNBOOK_REPO=repository
RUNBOOK_COMMIT=40_hex_commit_sha
RUNBOOK_PATH=docs/emergency-runbook.md
RUNBOOK_DIGEST=64_hex_sha256_of_exact_raw_bytes
RUNBOOK_MARKER=unique-section-heading

# Freeze this before running validators.
EXPECTED_VERDICT=RUNBOOK_EXECUTABLE
